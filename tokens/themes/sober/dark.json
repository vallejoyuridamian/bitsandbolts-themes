{
  "$extensions": {
    "com.bitsandbolts.derivation": {
      "manifest": "families/sober/v2/provenance.bb.json"
    }
  },
  "font": {
    "family": {
      "display": {
        "$value": "Merriweather"
      },
      "body": {
        "$value": "Antic"
      },
      "mono": {
        "$value": "JetBrains Mono"
      },
      "terminal": {
        "$value": "JetBrains Mono"
      }
    },
    "tracking": {
      "normal": {},
      "tighter": {
        "$value": "calc(var(--tracking-normal) - 0.05em)"
      },
      "tight": {
        "$value": "calc(var(--tracking-normal) - 0.025em)"
      },
      "wide": {
        "$value": "calc(var(--tracking-normal) + 0.025em)"
      },
      "wider": {
        "$value": "calc(var(--tracking-normal) + 0.05em)"
      },
      "widest": {
        "$value": "calc(var(--tracking-normal) + 0.1em)"
      }
    }
  },
  "spacing": {
    "0": {
      "$value": "0px",
      "$type": "dimension"
    },
    "1": {
      "$value": "0.23rem",
      "$type": "dimension"
    },
    "2": {
      "$value": "0.46rem",
      "$type": "dimension"
    },
    "3": {
      "$value": "0.69rem",
      "$type": "dimension"
    },
    "4": {
      "$value": "0.92rem",
      "$type": "dimension"
    },
    "5": {
      "$value": "1.15rem",
      "$type": "dimension"
    },
    "6": {
      "$value": "1.38rem",
      "$type": "dimension"
    },
    "8": {
      "$value": "1.84rem",
      "$type": "dimension"
    },
    "10": {
      "$value": "2.3rem",
      "$type": "dimension"
    },
    "12": {
      "$value": "2.76rem",
      "$type": "dimension"
    },
    "16": {
      "$value": "3.68rem",
      "$type": "dimension"
    },
    "20": {
      "$value": "4.6rem",
      "$type": "dimension"
    },
    "24": {
      "$value": "5.52rem",
      "$type": "dimension"
    }
  },
  "radius": {
    "none": {
      "$value": "0px",
      "$type": "dimension"
    },
    "xs": {
      "$value": "0.0875rem",
      "$type": "dimension"
    },
    "sm": {
      "$value": "0.175rem",
      "$type": "dimension"
    },
    "md": {
      "$value": "0.35rem",
      "$type": "dimension"
    },
    "lg": {
      "$value": "0.525rem",
      "$type": "dimension"
    },
    "xl": {
      "$value": "0.7rem",
      "$type": "dimension"
    },
    "2xl": {
      "$value": "1.05rem",
      "$type": "dimension"
    },
    "full": {
      "$value": "9999px",
      "$type": "dimension"
    }
  },
  "shadow": {
    "none": {
      "$value": "none"
    },
    "2xs": {
      "$value": "0px 1px 2px 0px hsl(0 0% 0% / 0.02)"
    },
    "xs": {
      "$value": "0px 1px 2px 0px hsl(0 0% 0% / 0.02)"
    },
    "sm": {
      "$value": "0px 1px 2px 0px hsl(0 0% 0% / 0.04), 0px 1px 2px -1px hsl(0 0% 0% / 0.04)"
    },
    "base": {
      "$value": "0px 1px 2px 0px hsl(0 0% 0% / 0.04), 0px 1px 2px -1px hsl(0 0% 0% / 0.04)"
    },
    "md": {
      "$value": "0px 1px 2px 0px hsl(0 0% 0% / 0.04), 0px 2px 4px -1px hsl(0 0% 0% / 0.04)"
    },
    "lg": {
      "$value": "0px 1px 2px 0px hsl(0 0% 0% / 0.04), 0px 4px 6px -1px hsl(0 0% 0% / 0.04)"
    },
    "xl": {
      "$value": "0px 1px 2px 0px hsl(0 0% 0% / 0.04), 0px 8px 10px -1px hsl(0 0% 0% / 0.04)"
    },
    "2xl": {
      "$value": "0px 1px 2px 0px hsl(0 0% 0% / 0.10)"
    }
  },
  "marketing": {
    "heroIconGlow": {
      "$value": "{color.interaction.action}"
    },
    "highlight": {
      "$value": "{color.interaction.selected}"
    },
    "terminalBlend": {
      "$value": "{color.surface.subtle}"
    }
  },
  "opacity": {
    "actionIconInactive": {
      "$value": "0.42",
      "$type": "number"
    }
  }
}
