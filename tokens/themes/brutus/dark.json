{
  "font": {
    "family": {
      "display": { "$value": "Ultra" },
      "body": { "$value": "Roboto Slab" },
      "mono": { "$value": "Space Mono" },
      "terminal": { "$value": "Space Mono" }
    },
    "weight": {
      "regular": { "$value": "100" },
      "medium": { "$value": "200" },
      "semibold": { "$value": "400" },
      "bold": { "$value": "400" }
    }
  },
  "radius": {
    "none": { "$value": "0px", "$type": "dimension" },
    "xs": { "$value": "0px", "$type": "dimension" },
    "sm": { "$value": "0px", "$type": "dimension" },
    "md": { "$value": "0px", "$type": "dimension" },
    "lg": { "$value": "0px", "$type": "dimension" },
    "xl": { "$value": "0px", "$type": "dimension" },
    "2xl": { "$value": "0px", "$type": "dimension" },
    "full": { "$value": "9999px", "$type": "dimension" }
  },
  "shadow": {
    "none": { "$value": "none" },
    "sm": { "$value": "2px 2px 0 0 #000000" },
    "md": { "$value": "4px 4px 0 0 #000000" },
    "lg": { "$value": "6px 6px 0 0 #000000" },
    "xl": { "$value": "8px 8px 0 0 #000000" }
  },
  "marketing": {
    "heroIconGlow": { "$value": "{color.interaction.dropTarget}" },
    "highlight": { "$value": "{color.interaction.selected}" },
    "terminalBlend": { "$value": "{color.surface.subtle}" }
  },
  "opacity": {
    "actionIconInactive": { "$value": "0.48", "$type": "number" }
  }
}
