{
  "$extensions": {
    "com.bitsandbolts.interface": {
      "resolution": "canonical"
    }
  },
  "interface": {
    "workspace": {
      "background": {
        "$value": "{color.surface.canvas}"
      },
      "stageCheckerStrong": {
        "$value": "{color.surface.canvas}"
      },
      "stageCheckerSoft": {
        "$value": "{color.surface.subtle}"
      },
      "selectionSignal": {
        "$value": "{color.interaction.action}"
      }
    },
    "control": {
      "foreground": {
        "$value": "{color.content.primary}"
      },
      "hoverForeground": {
        "$value": "{color.content.primary}"
      },
      "disabledForeground": {
        "$value": "{color.content.secondary}"
      },
      "focusRing": {
        "$value": "{color.border.focusRing}"
      }
    },
    "interaction": {
      "hoverBackground": {
        "$value": "color-mix(in srgb, {color.interaction.action} 10%, transparent)"
      },
      "hoverShadow": {
        "$value": "{shadow.sm}"
      },
      "hoverTextShadow": {
        "$value": "none"
      },
      "pressedBackground": {
        "$value": "color-mix(in srgb, {color.interaction.action} 18%, transparent)"
      },
      "pressedShadow": {
        "$value": "{shadow.none}"
      },
      "pressedTextShadow": {
        "$value": "none"
      }
    },
    "scrollbar": {
      "thumb": {
        "$value": "color-mix(in srgb, {color.interaction.action} 72%, transparent)"
      },
      "track": {
        "$value": "{color.surface.subtle}"
      },
      "border": {
        "$value": "{color.border.default}"
      },
      "highlight": {
        "$value": "color-mix(in srgb, {color.content.primary} 18%, transparent)"
      }
    },
    "menu": {
      "background": {
        "$value": "{color.surface.raised}"
      },
      "border": {
        "$value": "{color.border.default}"
      },
      "shadow": {
        "$value": "{shadow.lg}"
      },
      "mutedForeground": {
        "$value": "{color.content.secondary}"
      },
      "metaForeground": {
        "$value": "{color.content.secondary}"
      },
      "disabledForeground": {
        "$value": "color-mix(in srgb, {color.content.secondary} 44%, transparent)"
      },
      "divider": {
        "$value": "{color.border.subtle}"
      },
      "scrollbarThumb": {
        "$value": "{interface.scrollbar.thumb}"
      },
      "scrollbarTrack": {
        "$value": "{interface.scrollbar.track}"
      }
    },
    "motion": {
      "quickDuration": {
        "$value": "120ms"
      },
      "quickEasing": {
        "$value": "linear"
      }
    }
  }
}
