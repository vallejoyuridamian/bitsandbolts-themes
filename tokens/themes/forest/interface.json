{
  "$extensions": { "com.bitsandbolts.interface": { "resolution": "canonical" } },
  "interface": {
    "workspace": {
      "background": { "$value": "{color.surface.canvas}" },
      "stageCheckerStrong": { "$value": "{color.surface.canvas}" },
      "stageCheckerSoft": { "$value": "{color.surface.subtle}" },
      "selectionSignal": { "$value": "{color.interaction.action}" }
    },
    "control": {
      "foreground": { "$value": "{color.content.primary}" },
      "hoverForeground": { "$value": "{color.content.primary}" },
      "disabledForeground": { "$value": "{color.content.secondary}" },
      "focusRing": { "$value": "{color.interaction.action}" }
    },
    "button": {
      "hoverBackground": { "$value": "{interface.interaction.hoverBackground}" },
      "hoverShadow": { "$value": "{interface.interaction.hoverShadow}" },
      "hoverTextShadow": { "$value": "{interface.interaction.hoverTextShadow}" },
      "hoverForeground": { "$value": "{interface.control.hoverForeground}" },
      "hoverFilter": { "$value": "none" },
      "pressedBackground": { "$value": "{interface.interaction.pressedBackground}" },
      "pressedShadow": { "$value": "{interface.interaction.pressedShadow}" },
      "pressedTextShadow": { "$value": "{interface.interaction.pressedTextShadow}" },
      "pressedForeground": { "$value": "{interface.control.hoverForeground}" },
      "pressedFilter": { "$value": "none" },
      "plainIconRestFilter": { "$value": "drop-shadow(0 0 2px color-mix(in srgb, var(--bb-v2-identity-primary) 18%, transparent))" },
      "plainIconHoverFilter": { "$value": "drop-shadow(0 0 5px color-mix(in srgb, var(--bb-v2-identity-primary) 62%, transparent))" },
      "plainIconHoverForeground": { "$value": "var(--bb-v2-identity-primary)" }
    },
    "interaction": {
      "hoverBackground": { "$value": "color-mix(in srgb, {color.interaction.action} 10%, transparent)" },
      "hoverShadow": { "$value": "0 3px 9px color-mix(in srgb, {color.surface.scrim} 14%, transparent)" },
      "hoverTextShadow": { "$value": "none" },
      "pressedBackground": { "$value": "color-mix(in srgb, {color.interaction.action} 18%, transparent)" },
      "pressedShadow": { "$value": "inset 0 1px 3px color-mix(in srgb, {color.surface.scrim} 16%, transparent)" },
      "pressedTextShadow": { "$value": "none" }
    },
    "scrollbar": {
      "thumb": { "$value": "color-mix(in srgb, {color.interaction.action} 72%, transparent)" },
      "track": { "$value": "{color.surface.subtle}" },
      "border": { "$value": "{color.border.default}" },
      "highlight": { "$value": "color-mix(in srgb, {color.content.primary} 18%, transparent)" }
    },
    "menu": {
      "background": { "$value": "{color.surface.surface}" },
      "border": { "$value": "{color.border.default}" },
      "shadow": { "$value": "{shadow.lg}" },
      "mutedForeground": { "$value": "{color.content.secondary}" },
      "metaForeground": { "$value": "{color.content.secondary}" },
      "disabledForeground": { "$value": "color-mix(in srgb, {color.content.secondary} 44%, transparent)" },
      "divider": { "$value": "{color.border.subtle}" },
      "scrollbarThumb": { "$value": "{interface.scrollbar.thumb}" },
      "scrollbarTrack": { "$value": "{interface.scrollbar.track}" }
    },
    "motion": {
      "quickDuration": { "$value": "140ms" },
      "quickEasing": { "$value": "ease" }
    }
  }
}
