{
  "$extensions": { "com.bitsandbolts.interface": { "resolution": "canonical" } },
  "interface": {
    "workspace": {
      "background": { "$value": "{color.surface.canvas}" },
      "stageCheckerStrong": { "$value": "{color.surface.canvas}" },
      "stageCheckerSoft": { "$value": "{color.surface.subtle}" },
      "selectionSignal": { "$value": "{color.interaction.action}" }
    },
    "control": {
      "foreground": { "$value": "{color.content.primary}" },
      "hoverForeground": { "$value": "{color.content.primary}" },
      "disabledForeground": { "$value": "{color.content.secondary}" },
      "focusRing": { "$value": "{color.interaction.action}" }
    },
    "button": {
      "hoverBackground": { "$value": "{interface.interaction.hoverBackground}" },
      "hoverShadow": { "$value": "{interface.interaction.hoverShadow}" },
      "hoverTextShadow": { "$value": "{interface.interaction.hoverTextShadow}" },
      "hoverForeground": { "$value": "{interface.control.hoverForeground}" },
      "hoverFilter": { "$value": "none" },
      "pressedBackground": { "$value": "{interface.interaction.pressedBackground}" },
      "pressedShadow": { "$value": "{interface.interaction.pressedShadow}" },
      "pressedTextShadow": { "$value": "{interface.interaction.pressedTextShadow}" },
      "pressedForeground": { "$value": "{interface.control.hoverForeground}" },
      "pressedFilter": { "$value": "none" },
      "plainIconRestFilter": { "$value": "drop-shadow(0 0 2px color-mix(in srgb, var(--bb-v2-identity-primary) 18%, transparent))" },
      "plainIconHoverFilter": { "$value": "drop-shadow(0 0 5px color-mix(in srgb, var(--bb-v2-identity-primary) 62%, transparent))" },
      "plainIconHoverForeground": { "$value": "var(--bb-v2-identity-primary)" }
    },
    "interaction": {
      "hoverBackground": { "$value": "radial-gradient(ellipse at center, color-mix(in srgb, {color.interaction.action} 1%, transparent) 0%, color-mix(in srgb, {color.interaction.action} 1%, transparent) 72%, color-mix(in srgb, {color.interaction.action} 4%, transparent) 84%, color-mix(in srgb, {color.interaction.action} 14%, transparent) 96%, color-mix(in srgb, {color.interaction.action} 7%, transparent) 100%)" },
      "hoverShadow": { "$value": "inset 0 0 11px color-mix(in srgb, {color.interaction.action} 8%, transparent), 0 0 12px color-mix(in srgb, {color.interaction.action} 10%, transparent)" },
      "hoverTextShadow": { "$value": "0 0 8px color-mix(in srgb, {color.interaction.action} 20%, transparent)" },
      "pressedBackground": { "$value": "radial-gradient(ellipse at center, color-mix(in srgb, {color.interaction.action} 2%, transparent) 0%, color-mix(in srgb, {color.interaction.action} 2%, transparent) 56%, color-mix(in srgb, {color.interaction.action} 8%, transparent) 70%, color-mix(in srgb, {color.interaction.action} 20%, transparent) 88%, color-mix(in srgb, {color.interaction.action} 28%, transparent) 97%, color-mix(in srgb, {color.interaction.action} 14%, transparent) 100%)" },
      "pressedShadow": { "$value": "inset 0 0 14px color-mix(in srgb, {color.interaction.action} 18%, transparent), 0 0 14px color-mix(in srgb, {color.interaction.action} 15%, transparent)" },
      "pressedTextShadow": { "$value": "0 0 10px color-mix(in srgb, {color.interaction.action} 32%, transparent)" }
    },
    "scrollbar": {
      "thumb": { "$value": "color-mix(in srgb, {color.interaction.action} 82%, transparent)" },
      "track": { "$value": "color-mix(in srgb, {color.surface.canvas} 64%, transparent)" },
      "border": { "$value": "color-mix(in srgb, {color.surface.canvas} 78%, transparent)" },
      "highlight": { "$value": "color-mix(in srgb, {color.content.primary} 22%, transparent)" }
    },
    "menu": {
      "background": { "$value": "color-mix(in srgb, {color.surface.surface} 98%, transparent)" },
      "border": { "$value": "color-mix(in srgb, {color.interaction.action} 28%, transparent)" },
      "shadow": { "$value": "{shadow.xl}" },
      "mutedForeground": { "$value": "{color.content.secondary}" },
      "metaForeground": { "$value": "{color.content.secondary}" },
      "disabledForeground": { "$value": "color-mix(in srgb, {color.content.secondary} 42%, transparent)" },
      "divider": { "$value": "color-mix(in srgb, {color.interaction.action} 18%, transparent)" },
      "scrollbarThumb": { "$value": "{interface.scrollbar.thumb}" },
      "scrollbarTrack": { "$value": "{interface.scrollbar.track}" }
    },
    "motion": {
      "quickDuration": { "$value": "140ms" },
      "quickEasing": { "$value": "ease" }
    }
  }
}
