{
  "$extensions": { "com.bitsandbolts.interface": { "resolution": "canonical" } },
  "interface": {
    "workspace": { "background": { "$value": "{color.background}" } },
    "control": {
      "foreground": { "$value": "{color.onBackground}" },
      "hoverForeground": { "$value": "{color.onBackground}" },
      "disabledForeground": { "$value": "{color.onSurfaceVariant}" },
      "focusRing": { "$value": "{color.primary}" }
    },
    "interaction": {
      "hoverBackground": { "$value": "color-mix(in srgb, {color.secondary} 34%, transparent)" },
      "hoverShadow": { "$value": "2px 2px 0 0 {color.outline}" },
      "hoverTextShadow": { "$value": "none" },
      "pressedBackground": { "$value": "color-mix(in srgb, {color.primary} 28%, transparent)" },
      "pressedShadow": { "$value": "none" },
      "pressedTextShadow": { "$value": "none" }
    },
    "scrollbar": {
      "thumb": { "$value": "{color.primary}" },
      "track": { "$value": "{color.surfaceVariant}" },
      "border": { "$value": "{color.outline}" },
      "highlight": { "$value": "{color.secondary}" }
    },
    "menu": {
      "background": { "$value": "{color.surface}" },
      "border": { "$value": "{color.outline}" },
      "shadow": { "$value": "{shadow.md}" },
      "mutedForeground": { "$value": "{color.onSurfaceVariant}" },
      "metaForeground": { "$value": "{color.onSurfaceVariant}" },
      "disabledForeground": { "$value": "color-mix(in srgb, {color.onSurfaceVariant} 48%, transparent)" },
      "divider": { "$value": "{color.outline}" },
      "scrollbarThumb": { "$value": "{interface.scrollbar.thumb}" },
      "scrollbarTrack": { "$value": "{interface.scrollbar.track}" }
    },
    "motion": {
      "quickDuration": { "$value": "100ms" },
      "quickEasing": { "$value": "linear" }
    }
  }
}
