    "tracking": {
      "normal": {
        "$value": "0em"
      },
      "tighter": {
        "$value": "calc(var(--tracking-normal) - 0.05em)"
      },
      "tight": {
        "$value": "calc(var(--tracking-normal) - 0.025em)"
      },
      "wide": {
        "$value": "calc(var(--tracking-normal) + 0.025em)"
      },
      "wider": {
        "$value": "calc(var(--tracking-normal) + 0.05em)"
      },
      "widest": {
        "$value": "calc(var(--tracking-normal) + 0.1em)"
      }
    }
