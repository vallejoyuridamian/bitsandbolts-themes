{
  "$extensions": {
    "com.bitsandbolts.derivation": {
      "manifest": "families/winter/v2/provenance.bb.json"
    }
  },
  "font": {
    "family": {
      "display": {
        "$value": "Syne"
      },
      "body": {
        "$value": "Inter"
      },
      "mono": {
        "$value": "IBM Plex Mono"
      },
      "terminal": {
        "$value": "IBM Plex Mono"
      }
    },
    "tracking": {
      "normal": {
        "$value": "0em"
      },
      "tighter": {
        "$value": "calc(var(--tracking-normal) - 0.05em)"
      },
      "tight": {
        "$value": "calc(var(--tracking-normal) - 0.025em)"
      },
      "wide": {
        "$value": "calc(var(--tracking-normal) + 0.025em)"
      },
      "wider": {
        "$value": "calc(var(--tracking-normal) + 0.05em)"
      },
      "widest": {
        "$value": "calc(var(--tracking-normal) + 0.1em)"
      }
    }
  },
  "spacing": {
    "0": {
      "$value": "0px",
      "$type": "dimension"
    },
    "1": {
      "$value": "0.25rem",
      "$type": "dimension"
    },
    "2": {
      "$value": "0.5rem",
      "$type": "dimension"
    },
    "3": {
      "$value": "0.75rem",
      "$type": "dimension"
    },
    "4": {
      "$value": "1rem",
      "$type": "dimension"
    },
    "5": {
      "$value": "1.25rem",
      "$type": "dimension"
    },
    "6": {
      "$value": "1.5rem",
      "$type": "dimension"
    },
    "8": {
      "$value": "2rem",
      "$type": "dimension"
    },
    "10": {
      "$value": "2.5rem",
      "$type": "dimension"
    },
    "12": {
      "$value": "3rem",
      "$type": "dimension"
    },
    "16": {
      "$value": "4rem",
      "$type": "dimension"
    },
    "20": {
      "$value": "5rem",
      "$type": "dimension"
    },
    "24": {
      "$value": "6rem",
      "$type": "dimension"
    }
  },
  "radius": {
    "none": {
      "$value": "0px",
      "$type": "dimension"
    },
    "xs": {
      "$value": "0.125rem",
      "$type": "dimension"
    },
    "sm": {
      "$value": "0.25rem",
      "$type": "dimension"
    },
    "md": {
      "$value": "0.5rem",
      "$type": "dimension"
    },
    "lg": {
      "$value": "0.75rem",
      "$type": "dimension"
    },
    "xl": {
      "$value": "1rem",
      "$type": "dimension"
    },
    "2xl": {
      "$value": "1.5rem",
      "$type": "dimension"
    },
    "full": {
      "$value": "9999px",
      "$type": "dimension"
    }
  },
  "shadow": {
    "none": {
      "$value": "none"
    },
    "2xs": {
      "$value": "0px 4px 8px -1px hsl(0 0% 0% / 0.05)"
    },
    "xs": {
      "$value": "0px 4px 8px -1px hsl(0 0% 0% / 0.05)"
    },
    "sm": {
      "$value": "0px 4px 8px -1px hsl(0 0% 0% / 0.10), 0px 1px 2px -2px hsl(0 0% 0% / 0.10)"
    },
    "base": {
      "$value": "0px 4px 8px -1px hsl(0 0% 0% / 0.10), 0px 1px 2px -2px hsl(0 0% 0% / 0.10)"
    },
    "md": {
      "$value": "0px 4px 8px -1px hsl(0 0% 0% / 0.10), 0px 2px 4px -2px hsl(0 0% 0% / 0.10)"
    },
    "lg": {
      "$value": "0px 4px 8px -1px hsl(0 0% 0% / 0.10), 0px 4px 6px -2px hsl(0 0% 0% / 0.10)"
    },
    "xl": {
      "$value": "0px 4px 8px -1px hsl(0 0% 0% / 0.10), 0px 8px 10px -2px hsl(0 0% 0% / 0.10)"
    },
    "2xl": {
      "$value": "0px 4px 8px -1px hsl(0 0% 0% / 0.25)"
    }
  },
  "marketing": {
    "heroIconGlow": {
      "$value": "{color.interaction.action}"
    },
    "highlight": {
      "$value": "{color.interaction.selected}"
    },
    "terminalBlend": {
      "$value": "{color.surface.subtle}"
    }
  },
  "opacity": {
    "actionIconInactive": {
      "$value": "0.42",
      "$type": "number"
    }
  }
}
