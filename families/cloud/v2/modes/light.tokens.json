{
  "palette": {
    "$type": "color",
    "identityAccentForeground": { "$value": { "colorSpace": "srgb", "components": [0, 0.184314, 0.313725], "alpha": 1, "hex": "#002F50" } },
    "primary": { "$value": { "colorSpace": "srgb", "components": [0.309804, 0.27451, 0.898039], "alpha": 1, "hex": "#4F46E5" } },
    "onPrimary": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 1, "hex": "#FFFFFF" } },
    "primaryContainer": { "$value": { "colorSpace": "srgb", "components": [0.878431, 0.905882, 1], "alpha": 1, "hex": "#E0E7FF" } },
    "onPrimaryContainer": { "$value": { "colorSpace": "srgb", "components": [0.117647, 0.105882, 0.294118], "alpha": 1, "hex": "#1E1B4B" } },
    "secondary": { "$value": { "colorSpace": "srgb", "components": [0.486275, 0.227451, 0.929412], "alpha": 1, "hex": "#7C3AED" } },
    "onSecondary": { "$value": "{palette.onPrimary}" },
    "secondaryContainer": { "$value": { "colorSpace": "srgb", "components": [0.929412, 0.913725, 0.996078], "alpha": 1, "hex": "#EDE9FE" } },
    "onSecondaryContainer": { "$value": { "colorSpace": "srgb", "components": [0.180392, 0.062745, 0.396078], "alpha": 1, "hex": "#2E1065" } },
    "tertiary": { "$value": { "colorSpace": "srgb", "components": [0.054902, 0.647059, 0.913725], "alpha": 1, "hex": "#0EA5E9" } },
    "onTertiary": { "$value": "{palette.onPrimary}" },
    "tertiaryContainer": { "$value": { "colorSpace": "srgb", "components": [0.878431, 0.94902, 0.996078], "alpha": 1, "hex": "#E0F2FE" } },
    "onTertiaryContainer": { "$value": { "colorSpace": "srgb", "components": [0.047059, 0.290196, 0.431373], "alpha": 1, "hex": "#0C4A6E" } },
    "error": { "$value": { "colorSpace": "srgb", "components": [0.701961, 0.14902, 0.117647], "alpha": 1, "hex": "#B3261E" } },
    "onError": { "$value": "{palette.onPrimary}" },
    "errorContainer": { "$value": { "colorSpace": "srgb", "components": [0.976471, 0.870588, 0.862745], "alpha": 1, "hex": "#F9DEDC" } },
    "onErrorContainer": { "$value": { "colorSpace": "srgb", "components": [0.254902, 0.054902, 0.043137], "alpha": 1, "hex": "#410E0B" } },
    "background": { "$value": { "colorSpace": "srgb", "components": [0.972549, 0.980392, 0.988235], "alpha": 1, "hex": "#F8FAFC" } },
    "onBackground": { "$value": { "colorSpace": "srgb", "components": [0.058824, 0.090196, 0.164706], "alpha": 1, "hex": "#0F172A" } },
    "surface": { "$value": "{palette.background}" },
    "onSurface": { "$value": "{palette.onBackground}" },
    "surfaceVariant": { "$value": { "colorSpace": "srgb", "components": [0.886275, 0.909804, 0.941176], "alpha": 1, "hex": "#E2E8F0" } },
    "onSurfaceVariant": { "$value": { "colorSpace": "srgb", "components": [0.278431, 0.333333, 0.411765], "alpha": 1, "hex": "#475569" } },
    "outline": { "$value": { "colorSpace": "srgb", "components": [0.580392, 0.639216, 0.721569], "alpha": 1, "hex": "#94A3B8" } },
    "outlineVariant": { "$value": { "colorSpace": "srgb", "components": [0.796078, 0.835294, 0.882353], "alpha": 1, "hex": "#CBD5E1" } },
    "inverseSurface": { "$value": { "colorSpace": "srgb", "components": [0.117647, 0.160784, 0.231373], "alpha": 1, "hex": "#1E293B" } },
    "inverseOnSurface": { "$value": { "colorSpace": "srgb", "components": [0.945098, 0.960784, 0.976471], "alpha": 1, "hex": "#F1F5F9" } },
    "inversePrimary": { "$value": { "colorSpace": "srgb", "components": [0.647059, 0.705882, 0.988235], "alpha": 1, "hex": "#A5B4FC" } },
    "scrim": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 1, "hex": "#000000" } },
    "warning": { "$value": { "colorSpace": "srgb", "components": [0.705882, 0.32549, 0.035294], "alpha": 1, "hex": "#B45309" } },
    "onWarning": { "$value": "{palette.onPrimary}" },
    "warningContainer": { "$value": { "colorSpace": "srgb", "components": [0.996078, 0.952941, 0.780392], "alpha": 1, "hex": "#FEF3C7" } },
    "onWarningContainer": { "$value": { "colorSpace": "srgb", "components": [0.470588, 0.207843, 0.058824], "alpha": 1, "hex": "#78350F" } },
    "success": { "$value": { "colorSpace": "srgb", "components": [0.086275, 0.639216, 0.290196], "alpha": 1, "hex": "#16A34A" } },
    "onSuccess": { "$value": "{palette.onPrimary}" },
    "successContainer": { "$value": { "colorSpace": "srgb", "components": [0.862745, 0.988235, 0.905882], "alpha": 1, "hex": "#DCFCE7" } },
    "onSuccessContainer": { "$value": { "colorSpace": "srgb", "components": [0.078431, 0.32549, 0.176471], "alpha": 1, "hex": "#14532D" } }
  },
  "color": {
    "$type": "color",
    "surface": {
      "canvas": { "$value": "{palette.background}" }, "surface": { "$value": "{palette.surface}" }, "subtle": { "$value": "{palette.surfaceVariant}" },
      "raised": { "$value": "{palette.background}" }, "sunken": { "$value": "{palette.surfaceVariant}" }, "overlay": { "$value": "{palette.background}" },
      "inverse": { "$value": "{palette.inverseSurface}" }, "disabled": { "$value": "{palette.outlineVariant}" }, "scrim": { "$value": "{palette.scrim}" }
    },
    "content": {
      "primary": { "$value": "{palette.onSurface}" }, "secondary": { "$value": "{palette.onSurfaceVariant}" }, "tertiary": { "$value": "{palette.onSurfaceVariant}" },
      "placeholder": { "$value": "{palette.outline}" }, "disabled": { "$value": "{palette.outline}" }, "inverse": { "$value": "{palette.inverseOnSurface}" },
      "brand": { "$value": "{palette.primary}" }, "link": { "$value": "{palette.tertiary}" }, "linkVisited": { "$value": "{palette.secondary}" }
    },
    "border": {
      "subtle": { "$value": "{palette.outlineVariant}" }, "default": { "$value": "{palette.outline}" }, "strong": { "$value": "{palette.onSurfaceVariant}" },
      "disabled": { "$value": "{palette.outlineVariant}" }, "divider": { "$value": "{palette.outlineVariant}" }, "focusRing": { "$value": "{palette.primary}" }, "focusRingOffset": { "$value": "{palette.background}" }
    },
    "interaction": {
      "action": { "$value": "{palette.primary}" }, "onAction": { "$value": "{palette.onPrimary}" }, "actionHover": { "$value": "{palette.primary}" }, "actionPressed": { "$value": "{palette.primary}" },
      "selected": { "$value": "{palette.primaryContainer}" }, "onSelected": { "$value": "{palette.onPrimaryContainer}" }, "selection": { "$value": "{palette.secondaryContainer}" }, "onSelection": { "$value": "{palette.onSecondaryContainer}" },
      "caret": { "$value": "{palette.primary}" }, "dropTarget": { "$value": "{palette.tertiary}" }, "dragPreview": { "$value": "{palette.tertiaryContainer}" }
    },
    "status": {
      "infoSurface": { "$value": "{palette.tertiaryContainer}" }, "infoContent": { "$value": "{palette.onTertiaryContainer}" }, "infoBorder": { "$value": "{palette.tertiary}" },
      "successSurface": { "$value": "{palette.successContainer}" }, "successContent": { "$value": "{palette.onSuccessContainer}" }, "successBorder": { "$value": "{palette.success}" },
      "warningSurface": { "$value": "{palette.warningContainer}" }, "warningContent": { "$value": "{palette.onWarningContainer}" }, "warningBorder": { "$value": "{palette.warning}" },
      "dangerSurface": { "$value": "{palette.errorContainer}" }, "dangerContent": { "$value": "{palette.onErrorContainer}" }, "dangerBorder": { "$value": "{palette.error}" }
    }
  }
}
