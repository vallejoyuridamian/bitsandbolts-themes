{
  "id": "Button",
  "contractVersion": "2.0.0",
  "anatomy": ["container", "leadingIcon", "label", "trailingIcon", "progress"],
  "variants": {
    "primary": {
      "background": "color.interaction.action",
      "foreground": "color.interaction.onAction",
      "border": "color.interaction.action"
    },
    "secondary": {
      "background": "color.interaction.selected",
      "foreground": "color.interaction.onSelected",
      "border": "color.border.default"
    },
    "quiet": {
      "background": "transparent",
      "foreground": "color.content.brand",
      "border": "color.border.subtle"
    },
    "destructive": {
      "background": "color.status.dangerSurface",
      "foreground": "color.status.dangerContent",
      "border": "color.status.dangerBorder"
    }
  },
  "sizes": {
    "small": { "minHeight": "40px", "paddingInline": "12px", "gap": "6px", "iconSize": "16px" },
    "medium": { "minHeight": "40px", "paddingInline": "16px", "gap": "8px", "iconSize": "18px" },
    "large": { "minHeight": "48px", "paddingInline": "20px", "gap": "10px", "iconSize": "20px" }
  },
  "stateMatrix": ["rest", "hover", "focusVisible", "pressed", "loading", "disabled"],
  "tokenBindings": {
    "hoverBackground": "color.interaction.actionHover",
    "pressedBackground": "color.interaction.actionPressed",
    "disabledBackground": "color.surface.disabled",
    "disabledForeground": "color.content.disabled",
    "disabledBorder": "color.border.disabled",
    "focusRing": "color.border.focusRing",
    "focusRingOffset": "color.border.focusRingOffset"
  },
  "presentation": {
    "shapeRadius": "4px",
    "shapeCut": "0px",
    "depthRest": "0 1px 2px color-mix(in srgb, var(--bb-v2-color-surface-scrim) 18%, transparent)",
    "depthHover": "0 4px 10px color-mix(in srgb, var(--bb-v2-color-surface-scrim) 22%, transparent)",
    "depthPressed": "none",
    "transitionDuration": "140ms",
    "transitionEasing": "ease",
    "reducedDuration": "0ms",
    "textTransform": "none",
    "hoverTransform": "none",
    "pressedTransform": "none",
    "loadingDuration": "700ms"
  },
  "accessibilityRequirements": {
    "minimumTouchTargetWeb": "44px",
    "minimumTouchTargetAndroid": "48dp",
    "focusIndicatorMinimum": "2px",
    "forcedColors": "native-boundaries"
  },
  "platformAdapters": ["web", "react", "compose", "react-native"],
  "fallbacks": {
    "roundedShape": "4px rounded rectangle",
    "softDepth": "strong border"
  },
  "specimenCases": [
    { "variant": "primary", "state": "rest", "label": "Primary" },
    { "variant": "primary", "state": "hover", "label": "Hover" },
    { "variant": "primary", "state": "focusVisible", "label": "Focus" },
    { "variant": "primary", "state": "pressed", "label": "Pressed" },
    { "variant": "primary", "state": "loading", "label": "Working" },
    { "variant": "primary", "state": "disabled", "label": "Disabled" },
    { "variant": "secondary", "state": "rest", "label": "Secondary" },
    { "variant": "quiet", "state": "rest", "label": "Quiet" },
    { "variant": "destructive", "state": "rest", "label": "Destructive" }
  ]
}
